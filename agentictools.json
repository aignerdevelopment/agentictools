      "15-no-assumptions-ask-first": {
        "path": "rules/15-no-assumptions-ask-first.md",
        "tags": [
          "process"
        ],
        "description": "Do not assume; ask on uncertainty and surface safe assumptions."
      },
      "16-project-documentation": {
        "path": "rules/16-project-documentation.md",
        "tags": [
          "core",
          "always",
          "docs"
        ],
        "description": "Update docs/project/ architectural documentation before creating the MR; separate from docs/wiki."
